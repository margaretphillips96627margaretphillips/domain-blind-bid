# Sepolia RPC URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployer Private Key (without 0x prefix)
SEPOLIA_DEPLOYER_KEY=your_private_key_here

# Relayer Private Key (without 0x prefix)
SEPOLIA_RELAYER_KEY=your_private_key_here

# Gateway Signer Address (Zama Official Gateway for Sepolia)
DOMAINVAULT_GATEWAY_SIGNER=0x687820221192C5B662b25367F70076A37bc79b6c

# Etherscan API Key
ETHERSCAN_API_KEY=your_etherscan_api_key

# WalletConnect Project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed Contract Address
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Sepolia Chain ID
VITE_SEPOLIA_CHAIN_ID=11155111

# Vercel Token (optional)
VERCEL_TOKEN=
