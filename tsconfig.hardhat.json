{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "mocha", "chai"],
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": ["./hardhat.config.ts", "./scripts", "./test", "./deploy", "./tasks", "./types"],
  "exclude": ["node_modules", "dist", "cache", "artifacts", "src", "public"]
}
